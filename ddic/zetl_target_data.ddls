@EndUserText.label : 'ETL Target Data Table'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #ALLOWED
define table zetl_target_data {
  key client          : abap.clnt not null;
  key id              : abap.char(10) not null;
  name                : abap.char(100);
  value               : abap.dec(15,2);
  transformed_value   : abap.dec(15,2);
  status              : abap.char(20);
  category            : abap.char(50);
  priority            : abap.int1;
  etl_run_id          : abap.char(20);
  processed_at        : abap.dec(15,0);
  processed_by        : abap.char(12);
}
